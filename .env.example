# ─── MikroTik Router ───────────────────────────────────────────────────────────
# IP address or hostname of your MikroTik router
MIKROTIK_HOST=192.168.88.1

# RouterOS user with read+write API access (create a dedicated user!)
MIKROTIK_USER=api-admin
MIKROTIK_PASS=your-secure-password

# Protocol: 'http' (default) or 'https'
# If using https with a self-signed cert, also set NODE_TLS_REJECT_UNAUTHORIZED=0
MIKROTIK_PROTOCOL=http

# ─── Dashboard Authentication ──────────────────────────────────────────────────
# Credentials for cafe admin login (not MikroTik credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Random secret for signing JWT tokens (run: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-secret-string

# ─── PC Network Configuration ─────────────────────────────────────────────────
# Base IP for PCs: PC-01 = BASE_IP.1, PC-02 = BASE_IP.2, etc.
PC_IP_BASE=192.168.1

# ─── Speed Presets (Mbps) ──────────────────────────────────────────────────────
# Adjust to match your ISP plans and cafe needs
SPEED_NORMAL_MBPS=50
SPEED_UPDATE_MBPS=200
SPEED_THROTTLE_MBPS=2

# ─── ISP Route Comments ────────────────────────────────────────────────────────
# These must match the 'comment' field on your default routes in MikroTik
# /ip route where dst-address=0.0.0.0/0
ISP1_NAME=ISP 1
ISP1_ROUTE_COMMENT=ISP1

ISP2_NAME=ISP 2
ISP2_ROUTE_COMMENT=ISP2

ISP3_NAME=ISP 3
ISP3_ROUTE_COMMENT=ISP3
