# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to true to run without the real router (uses realistic fake data)
MIKROTIK_MOCK=false

# ── MikroTik router ────────────────────────────────────────────────────────────
# IP address or hostname of your MikroTik router
MIKROTIK_HOST=192.168.0.1

# RouterOS user with read+write API access (create a dedicated API user)
MIKROTIK_USER=api-admin
MIKROTIK_PASS=your-secure-router-password

# Protocol: 'http' (default) or 'https'
# If using https with a self-signed cert, also set NODE_TLS_REJECT_UNAUTHORIZED=0
MIKROTIK_PROTOCOL=http

# ── DHCP server name ───────────────────────────────────────────────────────────
# Must exactly match the DHCP server name shown in /ip/dhcp-server/lease (server= field)
DHCP_SERVER_NAME=LAN

# ── Dashboard authentication ───────────────────────────────────────────────────
# Credentials for cafe admin login (NOT the MikroTik router password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Random secret for signing JWT tokens — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret-string

# ── ISP names + mangle rule comments ──────────────────────────────────────────
# mangleComment must exactly match the 'comment' field on the firewall mangle
# rule that routes LAN traffic through each ISP (/ip/firewall/mangle)
ISP1_NAME=STORM
ISP1_MANGLE_COMMENT=STORM ZONE

ISP2_NAME=TRANSWORLD
ISP2_MANGLE_COMMENT=TRANS ZONE

ISP3_NAME=PTCL
ISP3_MANGLE_COMMENT=PTCL ZONE
